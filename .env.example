# ─── IA (Claude API) ───────────────────────────────────────────────
# Sans clé, l'app tourne en mode "mock" (réponses IA simulées) : pratique pour développer gratuitement.
ANTHROPIC_API_KEY=
# Tests locaux avec ton abonnement Claude (via Claude Code, connecté avec /login) au lieu de l'API.
# DÉVELOPPEMENT UNIQUEMENT — interdit en production. Décommente pour l'activer :
# AI_PROVIDER=claude-cli
# Si "claude" n'est pas trouvé (Windows), chemin complet de l'exécutable :
# CLAUDE_CLI_PATH=
# Routage des modèles par niveau de coût (voir packages/ai/src/models.ts)
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_BALANCED=claude-sonnet-5-5
AI_MODEL_PREMIUM=claude-opus-5-5

# ─── Base de données ────────────────────────────────────────────────
# Sans DATABASE_URL, l'app utilise un stockage en mémoire (perdu au redémarrage).
DATABASE_URL=
# Avec Postgres (docker compose up -d) : DATABASE_URL=postgres://siteia:siteia@localhost:5432/siteia

# ─── Paiement (Stripe) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix créés dans le dashboard Stripe (création = paiement unique, hébergement = abonnement mensuel)
STRIPE_PRICE_CREATION=
STRIPE_PRICE_HOSTING=

# ─── E-mails (Resend) ───────────────────────────────────────────────
# Sans clé, aucun e-mail ne part : ils s'affichent sur http://localhost:3000/dev/emails
RESEND_API_KEY=
EMAIL_FROM=SiteIA <contact@ton-domaine.fr>

# ─── Tâches planifiées ──────────────────────────────────────────────
# Protège /api/cron/rapport-mensuel (à appeler le 1er de chaque mois). Obligatoire en production.
CRON_SECRET=

# ─── Back-office (/admin) ───────────────────────────────────────────
# Sans mot de passe : ouvert en local, désactivé en production.
ADMIN_PASSWORD=

# ─── Domaines / hébergement multi-tenant ────────────────────────────
# Domaine racine de l'app ; chaque site client est servi sur <slug>.ROOT_DOMAIN ou son propre domaine.
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
